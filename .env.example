# Copy to .env. Read by docker compose and the Makefile.

# Secret the UI's server side sends to the gateway. Change it.
API_KEY=change-me

# Which engine a request for plain "qwen7b" goes to. Leave unset to follow the
# engine `make up` started; set to trtllm or vllm to pin it.
# DEFAULT_ENGINE=trtllm

# Engine images, pinned. TensorRT-LLM has had no stable release since 1.2.1
# (April 2026) and removed its compiled-engine backend after 1.3.0rc20; this
# release candidate is the maintained line and the one with KV-cache and
# speculative-decoding metrics.
TRTLLM_IMAGE=nvcr.io/nvidia/tensorrt-llm/release:1.4.0rc4
VLLM_IMAGE=vllm/vllm-openai:v0.34.0

# Where model downloads and quantized checkpoints live on the GPU host. The
# defaults are ~/.cache/huggingface and ./models; override with absolute paths.
# HF_CACHE=/data/huggingface
# MODELS_DIR=/data/models
# Only needed for gated models; Qwen2.5 is not gated.
HF_TOKEN=

# Host ports.
UI_PORT=3000
GATEWAY_PORT=8080
GRAFANA_PORT=3001

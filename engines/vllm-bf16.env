# The unquantized model, as the accuracy reference only. Its weights take 15 of
# the 16 GB, so it runs with a short context and two requests at a time: enough
# to score gsm8k, far too little to serve.
VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct
VLLM_LABEL=BF16 reference
VLLM_ARGS=--max-model-len 2048 --max-num-seqs 2 --gpu-memory-utilization 0.97

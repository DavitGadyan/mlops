# trtllm-fp8 plus speculative decoding: a 0.5B draft model proposes up to
# DRAFT_LEN tokens and the 7B model verifies them in one forward pass.
TRTLLM_MODEL=/models/qwen2.5-7b-fp8
TRTLLM_LABEL=TRT-LLM FP8 + draft
SPEC_CONFIG={decoding_type: Draft_Target, max_draft_len: ${DRAFT_LEN:-4}, speculative_model: Qwen/Qwen2.5-0.5B-Instruct}

# NVIDIA has not tested this draft/target pair, and the two checkpoints declare
# different vocabulary sizes (152064 and 151936). If the engine rejects it, use
# the model-free suffix-automaton drafter instead:
# SPEC_CONFIG={decoding_type: SA, max_draft_len: ${DRAFT_LEN:-4}}
